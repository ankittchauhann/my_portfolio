---
interface Lane {
  items: string[];
  title: string;
}

interface Props {
  flows: string[];
  label: string;
  lanes: Lane[];
}

const { label, lanes, flows } = Astro.props;
---

<figure aria-label={label} class="arch w-full" data-ui>
  <div class="arch-lanes">
    {lanes.map((lane) => (
      <div class="arch-lane">
        <p class="arch-title">{lane.title}</p>
        <ul class="arch-items">
          {lane.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <figcaption class="arch-flows">
    <ul>
      {flows.map((flow) => <li>{flow}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  [data-ui].arch {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink);
  }
  [data-ui] .arch-lanes {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 48rem) {
    [data-ui] .arch-lanes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  [data-ui] .arch-lane {
    padding: 1rem;
    background: var(--ground);
    border: 1px solid var(--surface-2);
    border-radius: 6px;
  }
  [data-ui] .arch-title {
    font-size: 1rem;
    font-weight: 500;
  }
  [data-ui] .arch-items {
    display: grid;
    gap: 0.375rem;
    padding: 0;
    margin: 0.75rem 0 0;
    list-style: none;
  }
  [data-ui] .arch-items li {
    padding: 0.5rem 0.625rem;
    background: var(--surface);
    border-radius: 4px;
  }
  [data-ui] .arch-flows ul {
    display: grid;
    gap: 0.375rem;
    padding: 0;
    margin: 1rem 0 0;
    color: var(--ink-muted);
    list-style: none;
  }
</style>
