---
const filters = [
  "Status: Error, Idle",
  "Battery: under 50%",
  "Sort: battery, low first",
];
const rows = [
  { battery: 18, name: "AMR-03", status: "Error", zone: "Aisle 4" },
  { battery: 27, name: "AMR-21", status: "Idle", zone: "Charging" },
  { battery: 34, name: "AMR-09", status: "Idle", zone: "Dock 1" },
  { battery: 46, name: "AMR-14", status: "Error", zone: "Line 2" },
];
---

<div
  aria-label="Sample screen: a robot list filtered by status and battery, sorted by battery and paginated."
  class="query w-full max-w-[36rem]"
  data-ui
  role="img"
>
  <div class="query-filters">
    {filters.map((filter) => <span class="query-chip">{filter}</span>)}
  </div>
  <table class="query-table">
    <thead>
      <tr>
        <th>Robot</th>
        <th>Status</th>
        <th>Battery</th>
        <th>Zone</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td class="query-name">{row.name}</td>
          <td class:list={{ "query-warn": row.status === "Error" }}>
            {row.status}
          </td>
          <td class="query-num">{row.battery}%</td>
          <td>{row.zone}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="query-foot">4 of 24 robots · page 1 of 1</p>
</div>

<style>
  [data-ui].query {
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--ground);
    border: 1px solid var(--surface-2);
    border-radius: 6px;
  }
  [data-ui] .query-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--surface-2);
  }
  [data-ui] .query-chip {
    padding: 0.25rem 0.625rem;
    background: var(--surface);
    border-radius: 4px;
  }
  [data-ui] .query-table {
    width: 100%;
    border-collapse: collapse;
  }
  [data-ui] .query-table th,
  [data-ui] .query-table td {
    padding: 0.5rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--surface);
  }
  [data-ui] .query-table th {
    font-weight: 500;
    color: var(--ink-muted);
  }
  [data-ui] .query-name {
    font-weight: 500;
  }
  [data-ui] .query-num {
    font-variant-numeric: tabular-nums;
  }
  [data-ui] .query-warn {
    font-weight: 500;
    color: var(--bronze);
  }
  [data-ui] .query-foot {
    padding: 0.75rem 1rem;
    color: var(--ink-muted);
  }
</style>
