---
import { aboutFacts, career } from "@/data/site";
---

<section
  aria-labelledby="about-title"
  class="bg-surface px-page py-section"
  id="about"
>
  <div
    class="grid gap-10 lg:grid-cols-[calc(34vw-var(--page-margin))_1fr] lg:gap-x-0 lg:gap-y-[7.5rem]"
  >
    <div class="lg:row-start-1" data-reveal>
      <h2
        class="font-heading text-head text-ink leading-none uppercase"
        id="about-title"
      >
        About
      </h2>
      <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 lg:grid-cols-1">
        {aboutFacts.map((fact) => (
          <div>
            <dt class="text-ink-muted text-small">{fact.label}</dt>
            <dd class="text-ink text-small mt-1">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <p
      class="text-ink text-lead max-w-[56ch] leading-[1.35] lg:row-start-1 lg:max-w-none lg:pr-[10vw]"
      data-reveal
    >
      I'm Ankit Singh Chouhan, a Full Stack Developer II at ANSCER Robotics in
      Bangalore. I joined as a web developer intern in March 2023, became a web
      developer that July, and was promoted in April 2026. I build its web
      platform end to end: React front ends, Hono and Node APIs, MongoDB and
      Redis, live data streams, sign‑in and roles, and the Docker and CI
      pipelines that ship it all. I like software that stays fast and calm when
      a lot of live data arrives at once.
    </p>

    <p class="text-ink text-small font-medium lg:row-start-2" data-reveal>
      Record
    </p>
    <div class="lg:row-start-2 lg:max-w-[32rem]" data-reveal>
      <h3 class="text-ink-muted text-small font-sans leading-normal">
        Roles · {career.company}, {career.city}
      </h3>
      <ol class="mt-3 grid gap-2.5" reversed>
        {career.roles.map((role) => (
          <li class="text-ink text-small flex justify-between gap-4">
            <span>{role.title}</span>
            <span class="text-ink-muted shrink-0 tabular-nums">
              {role.dates}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
