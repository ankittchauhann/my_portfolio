---
import { person } from "@/data/site";

const year = new Date().getFullYear();
const links = [
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "#main", label: "Back to top" },
];
const linkClass =
  "min-h-tap text-ink hover:text-bronze inline-flex items-center transition-colors duration-150 lg:min-h-0";
---

<footer
  class="inverse px-page pt-section pb-[max(env(safe-area-inset-bottom),1.5rem)] lg:pb-8"
>
  <div
    class="text-small grid gap-2 lg:grid-cols-[1fr_auto_1fr] lg:items-baseline lg:gap-6"
  >
    <p class="text-ink-muted">Ankit Singh Chouhan, full‑stack developer</p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6">
      {links.map((link) => (
        <a class={linkClass} href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>
    <p
      class="text-ink-muted flex flex-wrap items-center gap-x-6 lg:justify-end"
    >
      <span>© {year}</span>
      <a class={linkClass} href={person.repo}>Source on GitHub</a>
    </p>
  </div>
</footer>
