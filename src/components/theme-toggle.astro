<button
  aria-label="Switch to dark theme"
  class="theme-toggle size-tap bg-ground/80 text-ink hover:text-bronze inline-flex items-center justify-center transition-colors duration-150 lg:bg-transparent"
  data-theme-toggle
  type="button"
>
  <svg
    aria-hidden="true"
    class="icon-moon size-5"
    fill="none"
    viewBox="0 0 24 24"
  >
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-linejoin="round"
      stroke-width="1.6"
    ></path>
  </svg>
  <svg
    aria-hidden="true"
    class="icon-sun size-5"
    fill="none"
    viewBox="0 0 24 24"
  >
    <circle
      cx="12"
      cy="12"
      r="4"
      stroke="currentColor"
      stroke-width="1.6"
    ></circle>
    <path
      d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-width="1.6"
    ></path>
  </svg>
</button>

<style>
  .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const media = matchMedia("(prefers-color-scheme: dark)");

  const apply = (theme: string) => {
    root.dataset.theme = theme;
    for (const button of document.querySelectorAll("[data-theme-toggle]")) {
      button.setAttribute(
        "aria-label",
        theme === "dark" ? "Switch to light theme" : "Switch to dark theme"
      );
    }
    document.dispatchEvent(new CustomEvent("themechange", { detail: theme }));
  };

  const saved = () => {
    try {
      return localStorage.getItem("theme");
    } catch {
      return null;
    }
  };

  apply(root.dataset.theme === "dark" ? "dark" : "light");

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Private mode: the choice lasts for this page view only.
      }
      apply(next);
    });
  }

  media.addEventListener("change", (event) => {
    if (!saved()) {
      apply(event.matches ? "dark" : "light");
    }
  });
</script>
