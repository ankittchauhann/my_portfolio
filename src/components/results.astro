---
import { stats } from "@/data/site";
---

<section
  aria-labelledby="results-title"
  class="px-page py-section lg:grid lg:grid-cols-12 lg:gap-x-6"
>
  <h2
    class="font-heading text-head text-ink leading-none uppercase lg:col-span-4"
    data-reveal
    id="results-title"
  >
    Results
  </h2>
  <dl class="mt-10 grid gap-y-7 lg:col-span-7 lg:col-start-6 lg:mt-0">
    {stats.map((row) => (
      <div
        class="grid grid-cols-[5.25rem_1fr] items-baseline gap-x-4 lg:grid-cols-[13rem_1fr] lg:gap-x-8"
        data-reveal
      >
        <dt class="font-heading text-ink text-lead lg:text-head text-right leading-none tabular-nums">
          {row.figure}
        </dt>
        <dd class="text-lead text-ink max-w-[40ch] leading-snug">{row.text}</dd>
      </div>
    ))}
  </dl>
</section>
