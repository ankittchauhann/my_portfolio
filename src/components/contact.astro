---
import { person } from "@/data/site";

const [user, domain] = person.email.split("@");
const linkClass =
  "min-h-tap text-ink hover:text-bronze inline-flex items-center transition-colors duration-150 sm:min-h-0";
---

<section
  aria-labelledby="contact-title"
  class="inverse px-page pt-section"
  id="contact"
>
  <h2
    class="text-ink text-lead max-w-[30ch] font-sans leading-snug font-medium"
    data-reveal
    id="contact-title"
  >
    Building something real‑time? I'd like to hear about it.
  </h2>

  <a
    class="contact-email text-ink hover:text-bronze focus-visible:text-bronze mt-6 block w-fit leading-[1.05] transition-colors duration-200 lg:mt-8"
    data-reveal
    href={`mailto:${person.email}`}
  >
    <span class="block lg:inline">{user}@</span
    ><span class="block lg:inline">{domain}</span>
  </a>

  <div
    class="text-small mt-8 flex flex-col gap-x-6 gap-y-1 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between lg:mt-10"
    data-reveal
  >
    <p class="flex flex-wrap items-baseline gap-x-6">
      <a class={linkClass} href={person.phoneHref}>{person.phone}</a>
      <span class="text-ink-muted">{person.city}</span>
    </p>
    <p class="flex gap-6">
      <a class={linkClass} href={person.github} rel="me">GitHub</a>
      <a class={linkClass} href={person.linkedin} rel="me">LinkedIn</a>
    </p>
  </div>
</section>

<style>
  .contact-email {
    font-size: calc((100vw - 2 * var(--page-margin)) / 7.15);
    letter-spacing: -0.02em;
  }

  @media (min-width: 64rem) {
    .contact-email {
      font-size: calc((100vw - 2 * var(--page-margin)) / 11.9);
    }
  }
</style>
